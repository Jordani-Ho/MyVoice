# ElevenLabs 的 API Key 由前端页面输入、每次请求时传给后端，
# 后端本身不需要在这里配置 API Key（这样更安全，Key 不会被写进代码或服务器配置里）。
#
# 这版后端不再需要 ALIYUN_WORKSPACE_ID / PUBLIC_BASE_URL 这些变量了
# （那些是阿里云那版专用的，换成 ElevenLabs 之后用不上，Render 上如果还留着
# 也没关系，代码不会读它们）。
#
# 本地开发用这个文件配置端口即可；部署到 Render 时通常不需要手动设置 PORT，
# 平台会自动注入。

PORT=3001

# 【选填，2026-09-22 新增】给 /mcp 这个远程 MCP 服务用的默认 ElevenLabs Key。
# 网页那两个接口不受影响，仍然是前端每次传 Key。
# 但 MCP 工具调用时，如果 Claude App / ChatGPT App 没有把 apiKey 当参数传进来，
# 就会用这里配置的值兜底——配了这个，日常用的时候就不用每次口头报 Key 了。
# 不配也没关系，工具调用时随时可以当参数补上。
MYVOICE_API_KEY=
