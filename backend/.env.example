# 本项目的阿里云 API Key 是由前端页面输入、每次请求时传给后端的，
# 后端本身不需要在这里配置 API Key（这样更安全，Key 不会被写进代码或服务器配置里）。
#
# 用法：复制这个文件为 .env（同目录下）用于本地开发；部署到 Render 时，
# 把下面这些变量加到 Render 的 Environment 页面里（不会用到 .env 文件本身）。

PORT=3001

# 【必填，2026-09-22 起新增】你的阿里云百炼 Workspace ID。
# 换成 qwen-audio-3.1-tts-flash 模型后，声音复刻和语音合成都要用到
# "工作空间专属域名"（形如 {WorkspaceId}.ap-southeast-1.maas.aliyuncs.com），
# 所以必须配置这个变量，否则接口会直接报错提醒你。
# 获取方式：百炼控制台 -> 右上角个人信息 / API-KEY 管理页面里能看到 Workspace ID。
ALIYUN_WORKSPACE_ID=

# 【选填】后端自己的公网地址，不带末尾斜杠，例如 https://myvoice-backend-rtwu.onrender.com。
# 声音复刻时，后端需要把你上传的音频临时"挂"在自己身上、让阿里云的服务器来抓取，
# 这个变量就是用来生成那个临时地址的。不填的话，后端会自动从请求头里推断
# （Render 部署下通常也能正常工作），只有在自动推断出问题时才需要手动填这个。
PUBLIC_BASE_URL=
